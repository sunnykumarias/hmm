{
  "manifest_version": 3,
  "name": "IG 2FA Auto Setup Helper",
  "version": "1.2",
  "description": "Auto detects TOTP secret on Instagram Accounts Center, submits the 2FA code automatically, and displays the key for saving.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://accountscenter.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG 2FA Helper"
  },
  "content_scripts": [
    {
      "matches": ["*://accountscenter.instagram.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://accountscenter.instagram.com/*", "*://*.instagram.com/*"]
    }
  ]
}
